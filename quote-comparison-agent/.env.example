# ── REQUIRED (primary reasoning) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── FALLBACK (OpenAI Agents SDK) ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Provider order: anthropic | openai | demo
# demo = rich mock data, no API calls
LLM_PROVIDER=anthropic

# ── WEB FETCH (optional — fetch fallback if blank) ───────────────────────────
TAVILY_API_KEY=

# ── GIT (for future push / CI) ───────────────────────────────────────────────
GIT_TOKEN=

# ── APP ──────────────────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=60
APP_NAME=Competitor Quote Comparison Agent
APP_BRAND=Quote Intelligence for the builder
